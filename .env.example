# Backend (artifyme-backend/.env or repo root when running go run)
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:root@localhost:5432/artifyme?sslmode=disable
MIGRATIONS_PATH=cmd/migrations
JWT_SECRET=change-me-in-production-use-long-random-string

# CORS (React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Stripe (optional for local MVP without payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/order/success
STRIPE_CANCEL_URL=http://localhost:5173/order/cancel

# S3 / MinIO (optional)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=artify-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true

# Frontend (artifyme-frontend/.env)
VITE_API_URL=http://localhost:8080
